---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'> & {
  label: string
}

const { label, target = '_blank', rel = 'noopener noreferrer nofollow', ...props } = Astro.props
---

<!-- A ruled row: mono key, serif value, and an external-link arrow. The whole row is the link,
     and it opens in a new tab by default. -->
<a
  class="group grid grid-cols-[1fr_auto] items-baseline gap-x-3.5 gap-y-0.5 py-2.5 no-underline sm:grid-cols-[5.5rem_1fr_auto]"
  target={target}
  rel={rel}
  {...props}
>
  <span class="kicker col-span-2 transition-colors group-hover:text-accent sm:col-span-1">{label}</span>
  <span><slot /></span>
  <span class="font-mono text-ink-faint text-meta transition-colors group-hover:text-accent" aria-hidden="true">↗</span>
</a>
